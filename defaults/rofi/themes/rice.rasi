/* Sleek Shell: borderless liquid-glass launcher (blur comes from the Hyprland layer rule) */
* {
    bg:        #1c1a3ccf;
    surface:   #ffffff1a;
    surface-hi:#ffffff2b;
    line:      #ffffff2e;
    fg:        #f4f1ff;
    muted:     #a9a6cc;
    dim:       #6f6c97;
    cyan:      #8be0ff;
    purple:    #b69aff;
    pink:      #ff70c5;

    background-color: transparent;
    text-color: @fg;
    font: "Inter 12";
}

window {
    location: center;
    anchor: center;
    width: 620px;
    background-color: @bg;
    border: 0px;
    border-radius: 26px;
    padding: 0;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 0;
    padding: 16px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 12px;
    padding: 14px 16px;
    background-color: @surface;
    border: 0px;
    border-radius: 18px;
}

prompt {
    font: "JetBrainsMono Nerd Font 14";
    text-color: @cyan;
    str: "󰍉";
    vertical-align: 0.5;
}

entry {
    placeholder: "Search apps";
    placeholder-color: @dim;
    cursor-color: @pink;
    vertical-align: 0.5;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    spacing: 4px;
    padding: 14px 0 0 0;
}

element {
    padding: 10px 12px;
    spacing: 14px;
    border-radius: 14px;
    orientation: horizontal;
}

element normal.normal, element alternate.normal { background-color: transparent; text-color: @fg; }
element selected.normal {
    background-color: #b69aff3d;
    border: 0px;
    text-color: @fg;
}
element normal.active, element alternate.active { text-color: @cyan; }
element selected.active { text-color: @cyan; background-color: #8be0ff22; }
element normal.urgent, element alternate.urgent { text-color: @pink; }

element-icon {
    size: 30px;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    highlight: bold #8be0ff;
    background-color: transparent;
    text-color: inherit;
}

message {
    padding: 10px 0 0 0;
}
textbox {
    text-color: @muted;
}

/* __THEME_BLOCK__ (generated by apply-theme.sh) */
* {
    bg:        #27272da8;
    accent:    #b69aff;
    fg:        #f2f2f7;
    muted:     #a8a8b4;
    dim:       #707078;
}
/* __THEME_END__ */
